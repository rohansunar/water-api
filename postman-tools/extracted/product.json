      "name": "Vendor Products",
      "description": "Vendor-specific product management endpoints",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{vendorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"storeId\": \"123\",\n  \"title\": \"Premium Mineral Water 20L\",\n  \"sku\": \"PW-20L-001\",\n  \"description\": \"Premium quality mineral water in 20L container\",\n  \"category\": \"water_jar\",\n  \"attributes\": {\n    \"size\": \"20L\",\n    \"type\": \"mineral\",\n    \"brand\": \"AquaPure\"\n  },\n  \"base_price\": 50.00,\n  \"unit\": \"liter\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendors/me/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "me",
                "products"
              ]
            },
            "description": "Create a new product for the authenticated vendor",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 201\", function () {",
                    "    pm.response.to.have.status(201);",
                    "});",
                    "",
                    "pm.test(\"Response has required product fields\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData).to.have.property('id');",
                    "    pm.expect(jsonData).to.have.property('vendor_id');",
                    "    pm.expect(jsonData).to.have.property('title');",
                    "    pm.expect(jsonData).to.have.property('sku');",
                    "    pm.expect(jsonData).to.have.property('category');",
                    "    pm.expect(jsonData).to.have.property('base_price');",
                    "    pm.expect(jsonData).to.have.property('unit');",
                    "    pm.expect(jsonData).to.have.property('is_active');",
                    "});"
                  ]
                }
              }
            ]
          }
        },
