                "value": "Bearer {{vendorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Downtown Water Store\",\n  \"address\": \"123 Main Street, Downtown, Mumbai, 400001\",\n  \"phone\": \"+91-9876543210\",\n  \"active_hours\": {\n    \"monday\": {\"open\": \"09:00\", \"close\": \"21:00\"},\n    \"tuesday\": {\"open\": \"09:00\", \"close\": \"21:00\"},\n    \"wednesday\": {\"open\": \"09:00\", \"close\": \"21:00\"},\n    \"thursday\": {\"open\": \"09:00\", \"close\": \"21:00\"},\n    \"friday\": {\"open\": \"09:00\", \"close\": \"21:00\"},\n    \"saturday\": {\"open\": \"09:00\", \"close\": \"22:00\"},\n    \"sunday\": {\"open\": \"10:00\", \"close\": \"20:00\"}\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/vendors/me/stores",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "vendors",
                "me",
                "stores"
              ]
            },
            "description": "Create a new store for the authenticated vendor",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 201\", function () {",
                    "    pm.response.to.have.status(201);",
                    "});",
                    "",
                    "pm.test(\"Response has store fields\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData).to.have.property('id');",
                    "    pm.expect(jsonData).to.have.property('vendor_id');",
                    "    pm.expect(jsonData).to.have.property('name');",
                    "    pm.expect(jsonData).to.have.property('address');",
                    "    pm.expect(jsonData).to.have.property('is_active');",
                    "});"
                  ]
                }
              }
