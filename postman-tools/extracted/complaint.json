{
  "info": {
    "name": "Complaint API Collection",
    "description": "API endpoints for complaint module",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4242",
      "type": "string"
    },
    {
      "key": "vendorToken",
      "value": "",
      "type": "string",
      "description": "JWT token for authenticated vendor requests"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string",
      "description": "JWT token for authenticated admin requests"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string",
      "description": "JWT token for authenticated customer requests"
    },
    {
      "key": "riderToken",
      "value": "",
      "type": "string",
      "description": "JWT token for authenticated rider requests"
    }
  ],
  "item": [
    {
      "name": "Complaint Management",
      "description": "Customer complaint management endpoints",
      "item": [
        {
          "name": "Create Complaint",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"order123\",\n  \"subject\": \"Wrong product delivered\",\n  \"description\": \"Received mineral water instead of packaged drinking water\",\n  \"category\": \"wrong_product\",\n  \"priority\": \"medium\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/complaints",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints"
              ]
            },
            "description": "Create a new complaint for an order",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 201\", function () {",
                    "    pm.response.to.have.status(201);",
                    "});",
                    "",
                    "pm.test(\"Response has complaint fields\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData).to.have.property('id');",
                    "    pm.expect(jsonData).to.have.property('orderId');",
                    "    pm.expect(jsonData).to.have.property('status');",
                    "    pm.expect(jsonData).to.have.property('createdAt');",
                    "});"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Get User Complaints",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints?page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Get all complaints for the authenticated user",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test(\"Response is array of complaints\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData).to.be.an('array');",
                    "});"
                  ]
                }
              }
            ]
          }
        },
        {
          "name": "Get Complaint by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{customerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/complaints/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "complaints",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "complaint123"
                }
              ]
            },
            "description": "Get a specific complaint by ID",
            "event": [
              {
                "listen": "test",
                "script": {
                  "exec": [
                    "pm.test(\"Status code is 200\", function () {",
                    "    pm.response.to.have.status(200);",
                    "});",
                    "",
                    "pm.test(\"Response has complaint fields\", function () {",
                    "    var jsonData = pm.response.json();",
                    "    pm.expect(jsonData).to.have.property('id');",
                    "    pm.expect(jsonData).to.have.property('orderId');",
                    "    pm.expect(jsonData).to.have.property('status');",
                    "});"
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{riderToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This script runs before every request",
          "// You can add common setup logic here",
          "console.log('Making request to: ' + pm.request.url.toString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// This script runs after every request",
          "// You can add common test logic here",
          "console.log('Request completed with status: ' + pm.response.code);",
          "",
          "// Check for common error responses",
          "if (pm.response.code >= 400) {",
          "    console.log('Error response:', pm.response.json());",
          "}"
        ]
      }
    }
  ]
}