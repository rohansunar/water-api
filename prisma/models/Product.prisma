model Product {
  id               BigInt   @id @default(autoincrement())
  vendorId         BigInt
  name             String
  category         String
  subcategory      String?
  price            Decimal  @db.Decimal(10, 2)
  description      String?
  capacity         String
  unit             String
  stock            Int      @default(0)
  isAvailable      Boolean  @default(true)
  stockQuantity    Int      @default(0)
  isActive         Boolean  @default(false)
  minOrderQuantity Int      @default(1)
  maxOrderQuantity Int      @default(1000)
  areaPincodes     String[]
  images           String[]
  specifications   Json?
  hasDeposit       Boolean  @default(false)
  depositAmount    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @db.Timestamptz

  // Moderation fields
  moderationStatus ProductModerationStatus @default(PENDING)
  flaggedReason    String?
  moderatedBy      BigInt?
  moderatedAt      DateTime?               @db.Timestamptz
  autoFlagged      Boolean                 @default(false)
  complianceIssues Json?

  // Relations
  vendor        Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  storeMappings ProductStoreMapping[]
  moderator     Admin?                @relation(fields: [moderatedBy], references: [id])
  OrderItem     OrderItem[]
  Subscription  Subscription[]

  @@map("products")
}