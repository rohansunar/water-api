// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Customer {
  id                BigInt   @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  name              String
  loyaltyPoints     Int      @default(0)
  preferences       Json?
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
  lastActiveAt      DateTime? @db.Timestamptz

  // Relations
  addresses         CustomerAddress[]
  orders            Order[]
  subscriptions     Subscription[]
  deliveryTasks     DeliveryTask[]

  @@map("customers")
}

model Vendor {
  id                BigInt   @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  name              String
  kycStatus         String   @default("pending")
  gstin             String?
  bankAccountId     BigInt?
  rating            Decimal? @default(0) @db.Decimal(3, 2)
  isVerified        Boolean  @default(false)
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
  lastActiveAt      DateTime? @db.Timestamptz
  metadata          Json?

  // Relations
  stores            VendorStore[]
  addresses         VendorAddress[]
  products          Product[]
  orders            Order[]
  subscriptions     Subscription[]
  ledgerEntries     LedgerEntry[]
  payouts           Payout[]
  deliveryTasks     DeliveryTask[]
  staff             VendorStaff[]
  cashTransactions  CashTransaction[]

  @@map("vendors")
}

model Rider {
  id                BigInt   @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  name              String
  licenseNo         String?
  vehicleType       String?
  shift             Json?
  status            String   @default("inactive")
  rating            Decimal? @default(0) @db.Decimal(3, 2)
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
  lastActiveAt      DateTime? @db.Timestamptz
  metadata          Json?

  // Relations
  orders            Order[]
  deliveryTasks     DeliveryTask[]
  deliveryEvents    DeliveryEvent[]
  cashTransactions  CashTransaction[]

  @@map("riders")
}

model Admin {
  id                BigInt   @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  phone             String?  @unique
  email             String?  @unique
  passwordHash      String?
  name              String
  roleLevel         String   @default("support")
  permissions       Json?
  isActive          Boolean  @default(true)
  isDeleted         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
  lastActiveAt      DateTime? @db.Timestamptz

  // Relations
  commissionRules   CommissionRule[]
  moderatedProducts Product[]
  processedRefunds  Refund[] @relation("RefundProcessor")
  approvedRefunds   Refund[] @relation("RefundApprover")
  createdEscalations Escalation[] @relation("EscalationCreator")
  resolvedEscalations Escalation[] @relation("EscalationResolver")
  auditLogs         AuditLog[]

  @@map("admins")
}

model VendorStore {
  id                BigInt   @id @default(autoincrement())
  vendorId          BigInt
  name              String
  addressId         BigInt?
  phone             String?
  activeHours       Json?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz

  // Relations
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  address           VendorAddress? @relation(fields: [addressId], references: [id])
  productMappings   ProductStoreMapping[]
  orders            Order[]
  subscriptions     Subscription[]
  deliveryTasks     DeliveryTask[]

  @@map("vendor_stores")
}

model CustomerAddress {
  id                BigInt   @id @default(autoincrement())
  customerId        BigInt
  label             String   @default("Home")
  line1             String
  line2             String?
  city              String
  state             String?
  country           String   @default("India")
  pincode           String
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders            Order[]
  subscriptions     Subscription[]

  @@map("customer_addresses")
}

model VendorAddress {
  id                BigInt   @id @default(autoincrement())
  vendorId          BigInt
  label             String   @default("Store")
  line1             String
  line2             String?
  city              String
  state             String?
  country           String   @default("India")
  pincode           String
  latitude          Decimal? @db.Decimal(10, 8)
  longitude         Decimal? @db.Decimal(11, 8)
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  vendor            Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  stores            VendorStore[]

  @@map("vendor_addresses")
}

model Product {
  id                BigInt   @id @default(autoincrement())
  vendorId          BigInt
  name              String
  category          String
  subcategory       String?
  basePrice         Decimal  @db.Decimal(10, 2)
  description       String?
  imageUrl          String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Moderation fields
  moderationStatus  ProductModerationStatus @default(PENDING)
  flaggedReason     String?
  moderatedBy       BigInt?
  moderatedAt       DateTime? @db.Timestamptz
  autoFlagged       Boolean @default(false)
  complianceIssues  Json?

  // Relations
  vendor            Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  storeMappings     ProductStoreMapping[]
  moderator         Admin?                @relation(fields: [moderatedBy], references: [id])

  @@map("products")
}

model ProductStoreMapping {
  id                BigInt   @id @default(autoincrement())
  productId         BigInt
  storeId           BigInt
  price             Decimal? @db.Decimal(10, 2)
  stockQuantity     Int      @default(0)
  reservedStock     Int      @default(0)
  isAvailable       Boolean  @default(true)
  areaPincodes      String[] @default([])
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  store             VendorStore @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]

  @@unique([productId, storeId])
  @@map("product_store_mapping")
}

model Order {
  id                BigInt
  orderUuid         String   @unique @default(uuid())
  customerId        BigInt
  vendorId          BigInt?
  storeId           BigInt?
  riderId           BigInt?
  addressId         BigInt
  orderNumber       String   @unique
  status            String   @default("placed")
  subtotal          Decimal  @db.Decimal(10, 2)
  deliveryFee       Decimal  @default(0) @db.Decimal(8, 2)
  taxAmount         Decimal  @default(0) @db.Decimal(8, 2)
  totalAmount       Decimal  @db.Decimal(10, 2)
  paymentMethod     String   @default("cash")
  paymentStatus     String   @default("pending")
  deliveryInstructions String?
  scheduledDelivery DateTime? @db.Timestamptz
  deliveredAt       DateTime? @db.Timestamptz
  subscriptionId    BigInt?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  customer          Customer            @relation(fields: [customerId], references: [id])
  vendor            Vendor?             @relation(fields: [vendorId], references: [id])
  store             VendorStore?        @relation(fields: [storeId], references: [id])
  rider             Rider?              @relation(fields: [riderId], references: [id])
  address           CustomerAddress     @relation(fields: [addressId], references: [id])
  subscription      Subscription?       @relation(fields: [subscriptionId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  ledgerEntries     LedgerEntry[]
  refunds           Refund[]
  deliveryTask      DeliveryTask?
  cashTransactions  CashTransaction[]

  @@id([id, createdAt])
  @@map("orders")
}

model OrderItem {
  id                BigInt   @id @default(autoincrement())
  orderId           BigInt
  orderCreatedAt    DateTime @db.Timestamptz
  productStoreId    BigInt
  productName       String?
  quantity          Int
  unitPrice         Decimal  @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)

  // Relations
  order             Order               @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt], onDelete: Cascade)
  productStore      ProductStoreMapping @relation(fields: [productStoreId], references: [id])

  @@map("order_items")
}

model Subscription {
  id                BigInt   @id @default(autoincrement())
  customerId        BigInt
  vendorId          BigInt?
  storeId           BigInt?
  addressId         BigInt
  name              String
  status            String   @default("active")
  frequencyType     String
  frequencyValue    Int?
  deliveryDays      String?
  products          Json
  preferredDeliveryTime DateTime?
  nextDeliveryDate  DateTime
  startDate         DateTime
  endDate           DateTime?
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  customer          Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor            Vendor?       @relation(fields: [vendorId], references: [id])
  store             VendorStore?  @relation(fields: [storeId], references: [id])
  address           CustomerAddress @relation(fields: [addressId], references: [id])
  orders            Order[]

  @@map("subscriptions")
}

model Payment {
  id                BigInt   @id @default(autoincrement())
  orderId           BigInt
  orderCreatedAt    DateTime @db.Timestamptz
  amount            Decimal  @db.Decimal(10, 2)
  paymentMethod     String
  status            String   @default("pending")
  gatewayTransactionId String?
  gatewayResponse   Json?
  createdAt         DateTime @default(now()) @db.Timestamptz
  completedAt       DateTime? @db.Timestamptz

  // Relations
  order             Order    @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt], onDelete: Cascade)

  @@map("payments")
}

model LedgerEntry {
  id                BigInt   @id @default(autoincrement())
  vendorId          BigInt
  orderId           BigInt?
  orderCreatedAt    DateTime? @db.Timestamptz
  type              String
  amount            Decimal  @db.Decimal(10, 2)
  balanceAfter      Decimal? @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz
  metadata          Json?

  // Relations
  vendor            Vendor   @relation(fields: [vendorId], references: [id])
  order             Order?   @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt])

  @@map("ledger_entries")
}

model Payout {
  id                BigInt   @id @default(autoincrement())
  vendorId          BigInt
  amount            Decimal  @db.Decimal(10, 2)
  status            String   @default("requested")
  bankAccountId     BigInt?
  initiatedAt       DateTime? @db.Timestamptz
  completedAt       DateTime? @db.Timestamptz
  reference         String?
  createdAt         DateTime @default(now()) @db.Timestamptz

  // Relations
  vendor            Vendor   @relation(fields: [vendorId], references: [id])

  @@map("payouts")
}

enum CommissionScope {
  GLOBAL
  CATEGORY
  VENDOR
  PRODUCT
}

enum ProductModerationStatus {
  PENDING
  APPROVED
  REJECTED
  FLAGGED
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}


model CommissionRule {
  id                BigInt   @id @default(autoincrement())
  scope             CommissionScope
  scopeId           String?  // category name, vendor uuid, product uuid
  percentage        Decimal  @db.Decimal(5, 2)
  priority          Int      @default(0) // higher = more specific
  isActive          Boolean  @default(true)
  createdBy         BigInt   // admin id
  createdAt         DateTime @default(now()) @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

  // Relations
  admin             Admin    @relation(fields: [createdBy], references: [id])

  @@map("commission_rules")
  }
  
  model Refund {
    id                BigInt   @id @default(autoincrement())
    orderId           BigInt
    orderCreatedAt    DateTime @db.Timestamptz
    amount            Decimal  @db.Decimal(10, 2)
    reason            String
    status            RefundStatus @default(PENDING)
    refundMethod      String?
    transactionId     String?
    processedBy       BigInt?
    processedAt       DateTime? @db.Timestamptz
    approvedBy        BigInt?
    approvedAt        DateTime? @db.Timestamptz
    notes             String?
    createdAt         DateTime @default(now()) @db.Timestamptz
    updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
  
    // Relations
    order             Order    @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt])
    processor         Admin?   @relation("RefundProcessor", fields: [processedBy], references: [id])
    approver          Admin?   @relation("RefundApprover", fields: [approvedBy], references: [id])
  
    @@map("refunds")
  }
  
  
  model AuditLog {
    id                BigInt   @id @default(autoincrement())
    adminId           BigInt
    action            String   // e.g., 'user_status_updated', 'product_approved', 'refund_processed'
    resourceType      String   // e.g., 'user', 'product', 'order', 'refund'
    resourceId        String   // ID of the affected resource
    oldValues         Json?    // Previous state (optional)
    newValues         Json?    // New state (optional)
    metadata          Json?    // Additional context
    ipAddress         String?
    userAgent         String?
    createdAt         DateTime @default(now()) @db.Timestamptz

    // Relations
    admin             Admin    @relation(fields: [adminId], references: [id])

    @@map("audit_logs")
  }

  // ===== DELIVERY SYSTEM TABLES =====

  enum TaskStatus {
    ASSIGNED
    ACCEPTED
    PICKED_UP
    DELIVERED
    FAILED
    CANCELLED
  }

  enum TaskPriority {
    LOW
    NORMAL
    HIGH
    URGENT
  }

  model DeliveryTask {
    id                BigInt   @id @default(autoincrement())
    taskUuid          String   @unique @default(uuid())
    orderId           BigInt
    orderCreatedAt    DateTime @db.Timestamptz
    riderId           BigInt?
    vendorId          BigInt
    storeId           BigInt?
    customerId        BigInt
    status            TaskStatus @default(ASSIGNED)
    priority          TaskPriority @default(NORMAL)
    scheduledPickup   DateTime? @db.Timestamptz
    scheduledDelivery DateTime? @db.Timestamptz
    actualPickup      DateTime? @db.Timestamptz
    actualDelivery    DateTime? @db.Timestamptz
    pickupLocation    Json?    // GPS coordinates and address
    deliveryLocation  Json?    // GPS coordinates and address
    deliveryOtp       String?  // 6-digit OTP for delivery verification
    proofPhotoUrl     String?  // Photo proof of delivery
    failureReason     String?
    notes             String?
    estimatedDistance Decimal? @db.Decimal(8, 2) // in km
    estimatedDuration Int?     // in minutes
    actualDistance    Decimal? @db.Decimal(8, 2)
    actualDuration    Int?     // in minutes
    createdAt         DateTime @default(now()) @db.Timestamptz
    updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
    assignedAt        DateTime? @db.Timestamptz
    acceptedAt        DateTime? @db.Timestamptz
    pickedUpAt        DateTime? @db.Timestamptz
    deliveredAt       DateTime? @db.Timestamptz
    failedAt          DateTime? @db.Timestamptz

    // Relations
    order             Order     @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt])
    rider             Rider?    @relation(fields: [riderId], references: [id])
    vendor            Vendor    @relation(fields: [vendorId], references: [id])
    store             VendorStore? @relation(fields: [storeId], references: [id])
    customer          Customer  @relation(fields: [customerId], references: [id])
    events            DeliveryEvent[]

    @@unique([orderId, orderCreatedAt])
    @@map("delivery_tasks")
  }

  model DeliveryEvent {
    id                BigInt   @id @default(autoincrement())
    taskId            BigInt
    eventType         String   // 'task_assigned', 'task_accepted', 'pickup_started', 'delivered', etc.
    eventData         Json?    // Event-specific data
    riderId           BigInt?
    location          Json?    // GPS coordinates at event time
    metadata          Json?    // Additional context
    createdAt         DateTime @default(now()) @db.Timestamptz

    // Relations
    task              DeliveryTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
    rider             Rider?       @relation(fields: [riderId], references: [id])

    @@map("delivery_events")
  }

  model VendorStaff {
    id                BigInt   @id @default(autoincrement())
    uuid              String   @unique @default(uuid())
    vendorId          BigInt
    name              String
    phone             String?  @unique
    email             String?  @unique
    role              String   // 'manager', 'staff', 'delivery_coordinator'
    permissions       Json?    // Specific permissions for this staff member
    isActive          Boolean  @default(true)
    isDeleted         Boolean  @default(false)
    createdAt         DateTime @default(now()) @db.Timestamptz
    updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz
    lastActiveAt      DateTime? @db.Timestamptz

    // Relations
    vendor            Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

    @@map("vendor_staff")
  }

  model CashTransaction {
    id                BigInt   @id @default(autoincrement())
    transactionUuid   String   @unique @default(uuid())
    orderId           BigInt?
    orderCreatedAt    DateTime? @db.Timestamptz
    riderId           BigInt?
    vendorId          BigInt?
    type              String   // 'delivery_payment', 'rider_earning', 'refund', 'adjustment'
    amount            Decimal  @db.Decimal(10, 2)
    paymentMethod     String   // 'cash', 'online', 'wallet'
    status            String   @default("pending") // 'pending', 'completed', 'failed', 'cancelled'
    reference         String?  // Order number, transaction ID, etc.
    notes             String?
    processedBy       BigInt?  // Admin or staff who processed
    processedAt       DateTime? @db.Timestamptz
    createdAt         DateTime @default(now()) @db.Timestamptz
    updatedAt         DateTime @default(now()) @updatedAt @db.Timestamptz

    // Relations
    order             Order?   @relation(fields: [orderId, orderCreatedAt], references: [id, createdAt])
    rider             Rider?   @relation(fields: [riderId], references: [id])
    vendor            Vendor?  @relation(fields: [vendorId], references: [id])

    @@map("cash_transactions")
  }

  model OtpCode {
    id                BigInt   @id @default(autoincrement())
    phone             String   @unique
    code              String   // Hashed OTP code
    purpose           String   // 'rider_login', 'delivery_verification', 'password_reset'
    expiresAt         DateTime @db.Timestamptz
    attempts          Int      @default(0)
    isUsed            Boolean  @default(false)
    createdAt         DateTime @default(now()) @db.Timestamptz
    usedAt            DateTime? @db.Timestamptz

    @@map("otp_codes")
  }

  model OutboxEvent {
    id                BigInt   @id @default(autoincrement())
    eventUuid         String   @unique @default(uuid())
    eventType         String   // 'order_placed', 'delivery_assigned', 'delivery_completed', etc.
    aggregateId       String   // ID of the aggregate that triggered the event
    aggregateType     String   // 'order', 'delivery_task', 'rider', etc.
    payload           Json     // Event data
    published         Boolean  @default(false)
    publishedAt       DateTime? @db.Timestamptz
    createdAt         DateTime @default(now()) @db.Timestamptz
    retryCount        Int      @default(0)

    @@map("outbox_events")
  }